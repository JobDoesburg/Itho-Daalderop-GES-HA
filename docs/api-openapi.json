    "/GetEanCode": {
      "get": {
        "tags": [
          "Power grid EAN code"
        ],
        "description": "Returns the EAN code of a power grid connection",
        "operationId": "GetEanCode",
        "responses": {
          "200": {
            "description": "Payload of GetEanCodeResponseContract",
