{
  "openapi": "3.0.1",
  "info": {
    "title": "Open API for Itho Daalderop CCA",
    "description": "API for the CCA app for wifi-connected boilers",
    "version": "8.0.0"
  },
  "servers": [
    {
      "url": "https://wifi-api.id-c.net/api"
    }
  ],
  "paths": {
    "/BoostBoiler": {
      "post": {
        "tags": [
          "DeviceMode"
        ],
        "description": "Requests to boost the boiler",
        "operationId": "BoostBoiler",
        "requestBody": {
          "description": "Serial Number of the connected device",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/boostBoilerRequestContract"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Response when the input is wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          },
          "404": {
            "description": "Device with Serial number not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          },
          "204": {
            "description": "Boiler is boosted successfully"
          }
        },
        "security": [
          {
            "user_auth_header": []
          }
        ]
      }
    },
