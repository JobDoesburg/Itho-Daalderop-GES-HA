            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          },
          "204": {
            "description": "Device PV settings are updated successfully"
          }
        },
        "security": [
          {
            "user_auth_header": []
          }
        ]
      }
    }
