            "nullable": true
          },
          "pvSetpoint": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pvSetpointHysteresis": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pvStartLimit": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pvStopLimit": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pvSwitchLimit": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "deviceStatusContract": {
        "type": "object",
        "properties": {
          "boilerContent": {
            "type": "number",
            "format": "double"
          },
          "boostActive": {
            "type": "boolean"
          },
          "deviceMode": {
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "devicePowerMeasured": {
            "type": "number",
            "format": "double"
          },
          "deviceSoftwareVersion": {
            "type": "string"
          },
          "deviceState": {
            "enum": [
              "Unknown",
              "Online",
              "OnlineCommand",
              "Sleep",
              "Offline",
              "OfflineTimeout",
              "OfflineCommand",
              "Connecting"
            ],
            "type": "string",
            "default": "Unknown"
          },
          "energyConsumption": {
            "type": "number",
            "format": "double"
          },
          "energySaving": {
            "type": "number",
            "format": "double"
          },
          "errorNumber": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pvPowerConsumption": {
            "type": "number",
            "format": "double"
          },
          "pvPowerProduction": {
            "type": "number",
            "format": "double"
          },
          "pvPowerNet": {
            "type": "number",
            "format": "double"
          },
          "legionellaPreventionTimer": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "energyConsumptionContract": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/energyConsumptionDataContract"
            }
          },
          "deviceId": {
            "type": "string"
          },
          "interval": {
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "serialNumber": {
            "type": "string"
          }
        }
      },
      "energyConsumptionDataContract": {
        "required": [
          "timeStamp"
        ],
        "type": "object",
        "properties": {
          "consumption": {
            "type": "number",
            "format": "double"
          },
          "consumptionNotDeliveredToNet": {
            "type": "number",
            "format": "double"
          },
          "costs": {
            "type": "number",
            "format": "double"
          },
          "previousConsumption": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "previousConsumptionNotDeliveredToNet": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "previousCosts": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "timeStamp": {
            "type": "integer",
            "format": "int64"
          },
          "previousTimeStamp": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "pvAverageNetPower": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pvActualConPower": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pvActualProdPower": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "faultContract": {
        "required": [
          "timeStamp"
        ],
        "type": "object",
        "properties": {
          "duration": {
            "type": "integer",
            "format": "int64"
          },
          "errorNumber": {
            "type": "integer",
            "format": "int32"
          },
          "timeStamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "getDeviceModeResponseContract": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/deviceModeContract"
          },
          "message": {
            "$ref": "#/components/schemas/statusMessageContract"
          }
        }
      },
      "getDevicePVSettingsResponseContract": {
        "type": "object",
        "properties": {
          "result": {
