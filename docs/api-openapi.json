  "components": {
    "schemas": {
      "boostBoilerRequestContract": {
        "required": [
          "activateBoost",
          "serialNumber"
        ],
        "type": "object",
        "properties": {
          "activateBoost": {
            "type": "boolean"
          },
          "serialNumber": {
            "type": "string"
          }
        }
      },
      "deviceModeContract": {
        "type": "object",
        "properties": {
          "deviceMode": {
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "schedule": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/iDictionary_int32"
            }
          },
          "serialNumber": {
            "type": "string"
          },
          "temperature": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "deviceModeRequestContract": {
        "required": [
          "deviceMode",
          "serialNumber"
        ],
        "type": "object",
        "properties": {
          "deviceMode": {
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "schedule": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/iDictionary_int32"
            }
          },
          "serialNumber": {
            "type": "string"
          },
          "temperature": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "devicePVSettingsContract": {
