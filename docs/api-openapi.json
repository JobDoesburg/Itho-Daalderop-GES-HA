    "/UpdateDeviceMode": {
      "post": {
        "tags": [
          "DeviceMode"
        ],
        "description": "Update Device Mode.\nDeviceMode string values are: \"SmartControl\", \"Schedule\", \"Continuous\", \"Holiday\"\nSchedule contains the day of the week as key (Monday = \"0\", Sunday = \"6\")",
        "operationId": "UpdateDeviceMode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/deviceModeRequestContract"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Response when the input is wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          },
          "404": {
            "description": "Response when serial number of the connected device is not found or if update is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          },
          "204": {
            "description": "Device Mode is updated successfully"
          }
        },
        "security": [
          {
            "user_auth_header": []
          }
        ]
      }
    },
