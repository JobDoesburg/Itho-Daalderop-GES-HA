    "/GetEnergyConsumption": {
      "get": {
        "tags": [
          "Device Status"
        ],
        "description": "Returns the Energy consumption of the connected device",
        "operationId": "GetEnergyConsumption",
        "parameters": [
          {
            "name": "serialNumber",
            "in": "query",
            "description": "Serial number of the connected device",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "The start date of the time range in milliseconds (epoch)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "The end date of the time range in milliseconds (epoch)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Time Interval - Day, Week, Month,Year",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includePreviousPeriod",
            "in": "query",
            "description": "Include Previous period for comparison. Previous period is based on time interval",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "refreshCache",
            "in": "query",
            "description": "When true the cached tariffs are cleared and re-fetched from Betty Blocks",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payload of GetEnergyConsumptionResponseContract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/getEnergyConsumptionResponseContract"
                }
              }
            }
          },
          "400": {
            "description": "Response when the input is wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          },
          "404": {
            "description": "Response when serial number is not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/responseContract"
                }
              }
            }
          }
        },
        "security": [
          {
            "user_auth_header": []
          }
        ]
      }
    },
